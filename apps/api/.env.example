# Servidor
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_VERSION=0.1.0

# MySQL — DigitalOcean Managed Database
DB_HOST=your-cluster-host.db.ondigitalocean.com
DB_PORT=25060
DB_USER=doadmin
DB_PASSWORD=
DB_NAME=jnk_portal_base
# Certificado CA do cluster (baixado no painel da DO) — use UMA das duas:
# DB_CA_CERT_PATH pra um arquivo local (bom em Droplet/dev), ou DB_CA_CERT
# com o conteúdo do .pem direto (bom em App Platform, sem sistema de
# arquivos persistente pra deixar um certificado ao lado do processo).
# Nunca commitar o certificado real nem preencher as duas ao mesmo tempo.
DB_CA_CERT_PATH=./certs/ca-certificate.crt
DB_CA_CERT=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Parâmetros do Sistema — chave de criptografia AES-256-GCM (32 bytes em hex)
PARAMETROS_ENCRYPTION_KEY=

# Azure AD (opcional — deixar em branco desativa o SSO, ver spec seção 10.5)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=
